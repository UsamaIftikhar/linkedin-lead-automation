DATABASE_URL="postgresql://postgres.your-project-ref:password%40123@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
PORT=3001
CORS_ORIGIN="http://localhost:3000,http://localhost:3002,https://linkedin-lead-automation-qe7u.vercel.app"

RAPIDAPI_KEY=""
RAPIDAPI_HOST="jsearch.p.rapidapi.com"
JSEARCH_ENDPOINT="https://jsearch.p.rapidapi.com/search"

# Upwork jobs (same RAPIDAPI_KEY; optional overrides)
UPWORK_RAPIDAPI_HOST="upwork-jobs-api3.p.rapidapi.com"
UPWORK_RAPIDAPI_URL="https://upwork-jobs-api3.p.rapidapi.com/upwork"

# Cron: GET /api/upwork-jobs/cron/fetch — optional auth: if set, use query cron_secret= or header X-Cron-Secret
UPWORK_CRON_SECRET=""
# Defaults when query params omitted (same meaning as /upwork-jobs/fetch)
UPWORK_CRON_Q="JavaScript|React"
UPWORK_CRON_SKILLS="JavaScript|React"
UPWORK_CRON_SKILLS_MATCH_MODE="all"
UPWORK_CRON_HOURLY_MIN_USD="10"
UPWORK_CRON_HOURLY_MAX_USD="30"
UPWORK_CRON_FIXED_MIN_USD="100"
UPWORK_CRON_FIXED_MAX_USD="10000"
UPWORK_CRON_LIMIT="20"

# New jobs — Slack (pick bot *or* webhook; bot enables per-job threads + reply "generate proposal")
# Bot: create Slack app → OAuth token (xoxb-), install to workspace, invite bot to channel.
#
# Event Subscriptions → Request URL (must be HTTPS; Slack cannot reach http://localhost):
#   Production: https://your-domain.com/api/slack/events
#   Local dev:  run a tunnel, then paste its HTTPS URL + path, e.g.
#     ngrok:     brew install ngrok && ngrok http 3001  →  https://abcd.ngrok-free.app/api/slack/events
#     Cloudflare: brew install cloudflared && cloudflared tunnel --url http://localhost:3001
#   Start the backend before clicking "Verify" (Slack sends a challenge POST).
# Subscribe to bot events: message.channels (and message.groups for private channels).
# Scopes: chat:write, channels:history (private channels: groups:history)
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
# Channel ID (C…) — required for bot posts; for webhooks only, set if Slack’s POST response omits "channel" (needed to map thread → job)
SLACK_UPWORK_CHANNEL_ID=""
# Incoming webhook: with SLACK_SIGNING_SECRET + Events, one POST per new job (when job UUIDs exist) stores ts → job for thread "generate proposal"
SLACK_WEBHOOK_URL=""
# WhatsApp (pick one): Twilio WhatsApp API
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO="whatsapp:+923001234567"
# OR CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_CALLMEBOT_PHONE=""
WHATSAPP_CALLMEBOT_APIKEY=""

HUNTER_API_KEY=""
HUNTER_MIN_CONFIDENCE=75

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Outbound Team <outreach@yourdomain.com>"
OUTREACH_REPLY_TO="reply@yourdomain.com"

# When false/unset, the daily pipeline will not auto-send bulk outreach (recommended).
PIPELINE_AUTO_SEND_EMAILS="false"
# Set to "true" only if you need POST /api/emails/send batch behavior (disabled by default).
ENABLE_BULK_OUTREACH="false"

# Optional: AI-generated drafts in the dashboard (falls back to a static template if unset).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Chat: OpenRouter is used when OPENROUTER_API_KEY is set (otherwise DashScope below).
# https://openrouter.ai/ — Qwen with reasoning: first request sends reasoning.enabled; later
# turns rely on reasoning_details on assistant messages (handled by the app).
OPENROUTER_API_KEY=""
OPENROUTER_API_BASE="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="qwen/qwen3.6-plus-preview:free"
# Upwork proposal generation (OpenRouter chat completions; override if needed)
OPENROUTER_PROPOSAL_MODEL="deepseek/deepseek-v4-flash"
# Embeddings for RAG over sample experience (OpenRouter embeddings API)
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"
OPENROUTER_REASONING_ENABLED="true"

# Qwen (Alibaba DashScope) — only if OPENROUTER_API_KEY is empty
QWEN_API_KEY=""
QWEN_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-turbo"

DEFAULT_JOB_KEYWORDS="software engineer, full stack developer"
DEFAULT_JOB_LOCATIONS="remote,new york"
CRON_SCHEDULE="0 8 * * *"
